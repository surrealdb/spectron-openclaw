{
  "plugins": {
    "slots": {
      "memory": "agentMemory"
    },
    "entries": {
      "agentMemory": {
        "enabled": true,
        "hooks": {
          "allowConversationAccess": true,
          "allowPromptInjection": true
        },
        "config": {
          "endpoint": "${AGENT_MEMORY_ENDPOINT}",
          "apiKey": "${AGENT_MEMORY_API_KEY}",
          "context": "${AGENT_MEMORY_CONTEXT}",
          "writeScope": "org/acme",
          "recallLens": "org/acme"
        }
      }
    }
  }
}
