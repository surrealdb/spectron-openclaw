{
	"name": "@surrealdb/agent-memory-openclaw",
	"version": "0.2.0",
	"description": "OpenClaw plugin that backs agent memory with SurrealDB Agent Memory.",
	"license": "Apache-2.0",
	"type": "module",
	"keywords": [
		"openclaw",
		"agent-memory",
		"surrealdb",
		"memory",
		"plugin",
		"agent"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/surrealdb/agent-memory-openclaw.git"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"README.md",
		"LICENSE"
	],
	"openclaw": {
		"extensions": [
			"./dist/index.js"
		],
		"compat": {
			"pluginApi": ">=2026.4.27",
			"minGatewayVersion": "2026.4.27"
		}
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"test": "vitest run",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@surrealdb/memory": "^1.0.0-alpha.9",
		"typebox": "^1.1.39"
	},
	"peerDependencies": {
		"openclaw": ">=2026.4.27"
	},
	"peerDependenciesMeta": {
		"openclaw": {
			"optional": true
		}
	},
	"devDependencies": {
		"@types/node": "^22.20.1",
		"tsup": "^8.3.5",
		"typescript": "^5.6.3",
		"vitest": "^5.0.0"
	}
}
