# Spectron connection used by the OpenClaw plugin.
# Referenced from ~/.openclaw/openclaw.json as ${SPECTRON_ENDPOINT} etc.

# API endpoint origin, no trailing slash. Cloud or self-hosted binary.
SPECTRON_ENDPOINT=https://your-context.aws.spectron.surrealdb.com

# Bearer API key (sp-...). Sent as Authorization: Bearer.
SPECTRON_API_KEY=sp-xxxxxxxx

# Context id. Each context is its own SurrealDB namespace and database.
SPECTRON_CONTEXT=my-agent
