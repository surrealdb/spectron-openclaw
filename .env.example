# AgentMemory connection used by the OpenClaw plugin.
# Referenced from ~/.openclaw/openclaw.json as ${AGENT_MEMORY_ENDPOINT} etc.

# API endpoint origin, no trailing slash. Cloud or self-hosted binary.
AGENT_MEMORY_ENDPOINT=https://your-context.aws.agentMemory.surrealdb.com

# Bearer API key (sp-...). Sent as Authorization: Bearer.
AGENT_MEMORY_API_KEY=sp-xxxxxxxx

# Context id. Each context is its own SurrealDB namespace and database.
AGENT_MEMORY_CONTEXT=my-agent
